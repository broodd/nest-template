HOST=0.0.0.0
PORT=8080
PREFIX=/api/v1

THROTTLE_TTL=60
THROTTLE_LIMIT=100

CORS_CREDENTIALS=true
CORS_ORIGIN=*

SWAGGER_MODULE=true
SWAGGER_LOGIN=false
SWAGGER_USERNAME_FILE=.secrets/swagger-username
SWAGGER_PASSWORD_FILE=.secrets/swagger-password

JWT_EXPIRES_ACCESS_TOKEN=5y
JWT_EXPIRES_REFRESH_TOKEN=1week
JWT_SECRET_ACCESS_TOKEN_FILE=.secrets/jwt-secret-access-token
JWT_SECRET_REFRESH_TOKEN_FILE=.secrets/jwt-secret-refresh-token

STORE_FILE_SIZE=5e6
STORE_MIME_TYPE=["image/jpeg", "image/jpg", "image/png", "application/pdf", "video/mp4", "video/webm"]

AWS_S3_BUCKET=files
AWS_S3_REGION=eu-central-1

CLIENT_URL=https://localhost:5137
SERVER_URL=http://localhost:8080
CDN=https://api.domain.com/uploads
CLOUD_FRONT_PAIR_ID_KEY_FILE=.secrets/cloud-front-pair-id-key
CLOUD_FRONT_PRIVATE_KEY_FILE=.secrets/cloud-front-private-key

REDIS_TLS=false
REDIS_HAS_PASSWORD=false
REDIS_HOST=localhost
REDIS_PORT=6379

CACHE_AUTH_TTL=1800000

TYPEORM_NAME=development
TYPEORM_TYPE=postgres
TYPEORM_HOST=localhost
TYPEORM_PORT=5432
TYPEORM_DATABASE=nft-boilerplate
TYPEORM_USERNAME_FILE=.secrets/postgres-user
TYPEORM_PASSWORD_FILE=.secrets/postgres-password
TYPEORM_POOL_SIZE=10
TYPEORM_SSL=false
TYPEORM_SSL_SELF=false
TYPEORM_CACHE=true
TYPEORM_LOGGING=all
TYPEORM_DROP_SCHEMA=false
TYPEORM_SYNCHRONIZE=true
TYPEORM_MIGRATIONS_RUN=true

# Send mail service transporters
# Gmail OAuth
# ---
# SENDMAIL_TRANSPORT=gmail-oauth
# SENDMAIL_FROM='"nest-template" <noreply@domain.name>'
# GOOGLE_OAUTH_CLIENT_ID_FILE=.secrets/google-oauth-client-id
# GOOGLE_OAUTH_CLIENT_SECRET_FILE=.secrets/google-oauth-client-secret
# GOOGLE_OAUTH_REFRESH_TOKEN_FILE=.secrets/google-oauth-refresh-token
# GOOGLE_OAUTH_USER_FILE=.secrets/smtp-user

# SendGrid
# ---
# SENDMAIL_TRANSPORT=sendgrid
# SENDMAIL_FROM='"nest-template" <noreply@domain.name>'
# SENDGRID_API_KEY_FILE=.secrets/sendgrid-api-key

# SMTP
# ---
SENDMAIL_TRANSPORT=smtp
SENDMAIL_FROM='"nest-template" <noreply@domain.name>'
SMTP_PORT=465
SMTP_HOST=smtp.gmail.com
SMTP_USER_FILE=.secrets/smtp-user
SMTP_PASS_FILE=.secrets/smtp-pass
SMTP_DKIM_DOMAIN=dkim-domain
SMTP_DKIM_SELECTOR=names-dkim-mail-key
SMTP_DKIM_SECRET_FILE=.secrets/smtp-dkim-secret

FIREBASE_PROJECT_ID_FILE=.secrets/firebase-project-id
FIREBASE_PRIVATE_KEY_FILE=.secrets/firebase-private-key
FIREBASE_CLIENT_EMAIL_FILE=.secrets/firebase-client-email

STRIPE_API_KEY_FILE=.secrets/stripe-api-key
STRIPE_PRODUCTS_FILE=.secrets/stripe-products
STRIPE_WEBHOOK_SECRET_FILE=.secrets/stripe-webhook-secret