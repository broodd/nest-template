<mjml>
  <!-- HEAD ATTRIBUTES -->
  <mj-include path="./partials/head-attributes.mjml" />

  <mj-body background-color="#FFFFFF" width="640px">
    <mj-wrapper
      padding="0px 0px 0px 0px"
      border="none"
      direction="ltr"
      text-align="center"
      border-radius="var(--Border-radius-border_radius_S, 8px)"
      background-color="#FFF"
    >
      <!-- HEADER -->
      <mj-include path="./partials/header.mjml" />

			<mj-section background-repeat="repeat" background-size="auto" background-position="top center" border="none" direction="ltr" text-align="center" padding="10px 0px 0px 0px">
        <mj-column border="none" vertical-align="top" padding="0px 0px 0px 0px">
          <mj-text align="left" font-size="22px" font-weight="bold" padding="10px 25px 10px 25px">
          <span style="white-space-collapse: preserve;">Welcome</span></mj-text>
        </mj-column>
      </mj-section>
      <mj-section background-repeat="repeat" background-size="auto" background-position="top center" border="none" direction="ltr" text-align="center" padding="10px 0px 0px 0px">
        <mj-column border="none" vertical-align="top" padding="0px 0px 0px 0px">
          <mj-text align="left" padding="1px 25px 1px 25px"><span>Hello,<span></mj-text>
        </mj-column>
      </mj-section>

			<mj-section background-repeat="repeat" background-size="auto" background-position="top center" border="none" direction="ltr" text-align="center" padding="1px 0px 1px 0px">
        <mj-column border="none" vertical-align="top" width="100%" padding="0px 0px 0px 0px">
          <mj-text align="left" line-height="20px" padding="0px 25px 0px 25px"><span style="line-height: var(--line-height-body-md, 20px);">
              <div style="">
                <font color="#4b5565">Some text</font>
              </div>
            </span></mj-text>
        </mj-column>
      </mj-section>

			<mj-section background-repeat="repeat" background-size="auto" background-position="top center" border="none" direction="ltr" text-align="center" padding="1px 0px 1px 0px">
        <mj-column border="none" vertical-align="top" padding="0px 0px 0px 0px">
          <mj-divider align="center" border-width="1px" border-style="solid" border-color="#cccccc" padding="10px 0px 10px 0px"></mj-divider>
        </mj-column>
      </mj-section>

			<mj-section background-repeat="repeat" background-size="auto" background-position="top center" border="none" direction="ltr" text-align="center" padding="0px 0px 0px 0px">
        <mj-column border="none" vertical-align="top" padding="0px 0px 0px 0px">
          <mj-button
            align="left"
            background-color="#3538CD"
            color="#FFFFFF"
            font-weight="600"
            border-radius="9999px"
            line-height="20px"
            target="_blank"
            vertical-align="middle"
            border="1px solid #E3E8EF"
            text-align="center"
            href="{{url}}"
            font-style="normal"
            font-size="14px"
            padding="20px 25px 10px 25px"
            inner-padding="10px 25px 10px 25px"
            >Verify Email</mj-button
          >
        </mj-column>
      </mj-section>

      <!-- FOOTER -->
      <mj-include path="./partials/footer.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
