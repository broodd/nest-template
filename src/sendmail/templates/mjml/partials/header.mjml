<mj-section background-repeat="repeat" background-size="auto" background-position="top center" border="none" direction="ltr" text-align="center" padding="20px 0px 0px 0px">
  <mj-column border="none" vertical-align="top" padding="0px 0px 0px 0px">
    <mj-image align="left" height="auto" src="{{serverURL}}/public/templates/img/logo.png" alt="Logo" width="60px" padding="10px 25px 10px 25px"></mj-image>
  </mj-column>
</mj-section>
