{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "main",
  "compilerOptions": {
    "plugins": ["@nestjs/swagger/plugin"],
    "assets": [
      {
        "include": "sendmail/templates/*",
        "outDir": "dist",
        "watchAssets": true
      },
      {
        "include": "sendmail/templates/mjml/*",
        "outDir": "dist",
        "watchAssets": true
      },
      {
        "include": "**/*.json"
      }
    ]
  }
}
