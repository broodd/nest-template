{
  "name": "nft-boilerplate",
  "version": "0.0.1",
  "description": "Nest.js is based on Fastify and TypeORM setup",
  "author": {
    "name": "broodd",
    "email": "svyatddev@gmail.com",
    "url": "https://github.com/broodd"
  },
  "private": true,
  "engines": {
    "node": "22.x",
    "npm": ">=10.x"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "mjml:build": "ts-node src/sendmail/compile-mjml.ts",
    "format-lint-staged": "lint-staged",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "cross-env NODE_ENV=development nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "typeorm:cli": "cross-env NODE_ENV=development node -r tsconfig-paths/register -r ts-node/register ./node_modules/typeorm/cli --d ./src/database/typeorm-migration.config.ts",
    "typeorm:create:migration": "npm run typeorm:cli -- migration:create -d src/database/migrations -n",
    "typeorm:migration:gen": "npm run typeorm:cli -- migration:generate src/database/migrations/migration",
    "doc": "npm run doc:generate -- -s",
    "doc:generate": "npx @compodoc/compodoc -p tsconfig.json -d docs --theme laravel",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "npm run test -- --watch",
    "test:cov": "npm run test -- --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prepare": "if [ \"$NODE_ENV\" != \"production\" ]; then husky install; fi"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.556.0",
    "@aws-sdk/cloudfront-signer": "^3.821.0",
    "@aws-sdk/lib-storage": "^3.556.0",
    "@casl/ability": "^6.7.3",
    "@fastify/basic-auth": "^5.1.1",
    "@fastify/compress": "^7.0.3",
    "@fastify/cookie": "^7.4.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^7.6.0",
    "@fastify/static": "^7.0.3",
    "@fastify/swagger": "^8.14.0",
    "@nestjs-modules/mailer": "^1.10.3",
    "@nestjs/bull": "^10.2.3",
    "@nestjs/cache-manager": "^2.2.2",
    "@nestjs/common": "10.3.8",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "10.3.8",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^10.3.8",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-fastify": "^10.4.15",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/swagger": "^7.3.1",
    "@nestjs/terminus": "^10.2.3",
    "@nestjs/throttler": "^4.2.1",
    "@nestjs/typeorm": "10.0.2",
    "@sendgrid/mail": "^8.1.6",
    "bull": "^4.16.4",
    "cache-manager-redis-yet": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cross-env": "^7.0.3",
    "csv-stringify": "^6.6.0",
    "dayjs": "^1.11.18",
    "dotenv": "^16.4.5",
    "firebase-admin": "^13.6.0",
    "geojson": "^0.5.0",
    "googleapis": "^161.0.0",
    "handlebars": "^4.7.8",
    "mjml": "^4.16.1",
    "nodemailer": "^6.10.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.5",
    "pg-query-stream": "^4.8.0",
    "randexp": "^0.5.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "stripe": "^18.5.0",
    "typeorm": "^0.3.20",
    "typeorm-transactional": "^0.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.6.7",
    "@commitlint/config-angular": "^17.6.7",
    "@compodoc/compodoc": "^1.1.21",
    "@nestjs/cli": "^10.1.10",
    "@nestjs/schematics": "^10.0.1",
    "@nestjs/testing": "^10.1.2",
    "@types/bull": "^4.10.0",
    "@types/cache-manager": "^4.0.2",
    "@types/dotenv": "^8.2.0",
    "@types/jest": "^29.5.3",
    "@types/node": "^20.4.5",
    "@types/nodemailer": "^6.4.17",
    "@types/passport": "^1.0.12",
    "@types/passport-jwt": "^3.0.9",
    "@types/stripe": "^8.0.416",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^6.2.0",
    "@typescript-eslint/parser": "^6.2.0",
    "chai": "^4.3.7",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.9.0",
    "eslint-plugin-perfectionist": "^4.9.0",
    "husky": "^8.0.3",
    "jest": "^29.6.2",
    "lint-staged": "^15.2.10",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.1",
    "sinon": "^15.2.0",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.4.4",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.6"
  },
  "jest": {
    "verbose": true,
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/src/$1",
      "^test/(.*)$": "<rootDir>/test/$1"
    },
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "testEnvironment": "node",
    "testRegex": "/src/.*\\.(test|spec).(ts|tsx|js)$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/src/database/migrations/"
    ],
    "coverageReporters": [
      "json-summary",
      "text",
      "lcov"
    ]
  },
  "compodoc": {
    "open": true,
    "hideGenerator": true,
    "output": "./public",
    "tsconfig": "./tsconfig.json",
    "unitTestCoverage": "./coverage/coverage-summary.json"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -c .commitlintrc.json -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
