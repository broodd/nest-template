HOST=0.0.0.0
PORT=8080
PREFIX=/api/v1

THROTTLE_TTL=60
THROTTLE_LIMIT=100

CORS_CREDENTIALS=true
CORS_ORIGIN=*

SWAGGER_MODULE=true
SWAGGER_LOGIN=true
SWAGGER_USERNAME_FILE=.secrets/swagger-username
SWAGGER_PASSWORD_FILE=.secrets/swagger-password

JWT_EXPIRES_ACCESS_TOKEN=15m
JWT_EXPIRES_REFRESH_TOKEN=1week
JWT_SECRET_ACCESS_TOKEN_FILE=.secrets/jwt-secret-access-token
JWT_SECRET_REFRESH_TOKEN_FILE=.secrets/jwt-secret-refresh-token

STORE_FILE_SIZE=5e6
STORE_MIME_TYPE=["image/jpeg", "image/jpg", "image/png", "application/pdf", "video/mp4", "video/webm"]

AWS_S3_BUCKET=files
AWS_S3_REGION=eu-central-1

CDN=http://localhost:8080/api/v1/files

REDIS_TLS=false
REDIS_HAS_PASSWORD=false
REDIS_HOST=localhost
REDIS_PORT=6379

CACHE_AUTH_TTL=1800000

TYPEORM_NAME=production
TYPEORM_TYPE=postgres
TYPEORM_HOST=localhost
TYPEORM_PORT=5432
TYPEORM_DATABASE=nft-boilerplate
TYPEORM_USERNAME_FILE=.secrets/postgres-user
TYPEORM_PASSWORD_FILE=.secrets/postgres-password
TYPEORM_SSL=false
TYPEORM_CACHE=true
TYPEORM_LOGGING=["error", "warn"]
TYPEORM_DROP_SCHEMA=false
TYPEORM_SYNCHRONIZE=true
TYPEORM_MIGRATIONS_RUN=true

# Send mail service transporters
# Gmail OAuth
# ---
SENDMAIL_TRANSPORT=gmail-oauth
SENDMAIL_FROM='Mehut Europe <mehutme@gmail.com>'
GOOGLE_OAUTH_CLIENT_ID_FILE=.secrets/google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET_FILE=.secrets/google-oauth-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN_FILE=.secrets/google-oauth-refresh-token
GOOGLE_OAUTH_USER_FILE=.secrets/smtp-user

